{
  "expo": {
    "name": "WhereReady Solar OS",
    "slug": "whereready-solar-os",
    "scheme": "whereready",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whereready.solaros"
    },
    "android": {
      "package": "com.whereready.solaros",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a777ad42-4a1a-48d3-be30-60d2b263af25"
      }
    },
    "owner": "mayurkukatkar"
  }
}
